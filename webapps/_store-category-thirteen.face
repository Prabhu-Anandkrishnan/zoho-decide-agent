                                            <path class="cls-3" d="M552,170.9l-75.2-30.1,44.1-13.1s-140.2-9.2-330.4,0l45.2,14.9-16.6,28.3c189,24.9,333,0,333,0Z"/>
                                            <path class="cls-5" d="M553.9,169.7c-25.1-10-50.1-20.1-75.2-30.1-.5.8-1.1,1.6-1.6,2.4,14.7-4.4,29.4-8.7,44.1-13.1,1.5-.5,3.3-2.5.6-2.6-19.7-1.3-39.4-2-59.1-2.6-51.8-1.6-103.7-1.9-155.6-1.1-38.8.6-77.6,1.8-116.4,3.7-1.3,0-4.2,1.9-1.8,2.7,15.1,5,30.1,10,45.2,14.9-.3-.5-.5-.9-.8-1.4-5.5,9.4-11.1,18.9-16.6,28.3-.4.7,0,1.3.8,1.4,64.7,8.5,130,12.1,195.2,10.9,39.6-.7,79.3-3.1,118.7-8,6.7-.8,13.5-1.7,20.2-2.9,2.3-.4,4-3.3.6-2.7-19.6,3.4-39.5,5.2-59.3,6.9-51.5,4.3-103.3,5.2-154.9,3.1-39.3-1.6-78.6-4.9-117.6-10,.3.5.5.9.8,1.4,5.5-9.4,11.1-18.9,16.6-28.3.4-.8,0-1.2-.8-1.4-15.1-5-30.1-10-45.2-14.9-.6.9-1.2,1.8-1.8,2.7,64.8-3.1,129.6-4.4,194.5-4,38.7.3,77.5,1.1,116.2,3,6.4.3,12.8.6,19.1,1,.2-.9.4-1.8.6-2.6-14.7,4.4-29.4,8.7-44.1,13.1-.6.2-3.3,1.7-1.6,2.4,25.1,10,50.1,20.1,75.2,30.1,1.5.6,5.9-1.6,3.8-2.4Z"/>
