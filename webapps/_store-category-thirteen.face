                                            <style>
                                                .cls-1 {
                                                    fill: #e3e3e3;
                                                }

                                                .cls-1, .cls-2, .cls-3, .cls-4, .cls-5, .cls-6 {
                                                    stroke-width: 0px;
                                                }

                                                .cls-2 {
                                                    fill: #f9f9f8;
                                                }

                                                .cls-3 {
                                                    fill: #efefee;
                                                }

                                                .cls-4 {
                                                    fill: #f4f4f4;
                                                }

                                                .cls-5 {
                                                    fill: #a8a8a8;
                                                }

                                                .cls-6 {
                                                    fill: #fff;
                                                }
                                            </style>
