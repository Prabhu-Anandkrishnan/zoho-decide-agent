
	{% if product.images | size < 2 %}

	<div class="theme-product-detail-image" data-zs-product-img-container>
		<div class="theme-product-detail-image-inner" data-lightbox-container="prod_images_grid_{{product.product_id}}">
			{% if product.images[0].is_placeholder_image %}
			<picture>
				<img alt="{{ product.images[0].alternate_text }}" src="{{cdn_prefix_url}}{{ product.images[0].url }}{{cdn_suffix_url}}" data-fallback="{{ product.images[0].url }}" onerror="handleFallBackForImage(this)" data-detail-image="theme-detail-image-{{product.product_id}}" data-lightbox-detailImage>
			</picture>
			{% else %}
			<picture>
				<img alt="{{ product.images[0].alternate_text }}" src="{{cdn_prefix_url}}{{ product.images[0].url }}/800x800{{cdn_suffix_url}}" data-fallback="{{ product.images[0].url }}/800x800" onerror="handleFallBackForImage(this)" data-detail-image="theme-detail-image-{{product.product_id}}" data-lightbox-detailImage>
			</picture>
			{% endif %}
		</div>
	</div>

	{% else %}

  <div class="theme-product-detail-image" data-zs-product-img-container>
      <div class="theme-product-detail-image-inner">

				<div class="theme-image-overlay" data-theme-image-overlay="theme-image-overlay-{{product.product_id}}">
					<div class="theme-image-loader"></div>
				</div>

        {% if product.images[0].is_placeholder_image %}
        <picture>
            <img alt="{{ product.images[0].alternate_text }}" src="{{cdn_prefix_url}}{{ product.images[0].url }}{{cdn_suffix_url}}" data-fallback="{{ product.images[0].url }}" onerror="handleFallBackForImage(this)" data-detail-image="theme-detail-image-{{product.product_id}}" data-lightbox-detailImage>
        </picture>
        {% else %}
        <picture>
            <img alt="{{ product.images[0].alternate_text }}" src="{{cdn_prefix_url}}{{ product.images[0].url }}/800x800{{cdn_suffix_url}}" data-fallback="{{ product.images[0].url }}/800x800" onerror="handleFallBackForImage(this)" data-detail-image="theme-detail-image-{{product.product_id}}" data-lightbox-detailImage>
        </picture>
        {% endif %}
      </div>
  </div>

	<div class="theme-product-detail-thumbnail-container" data-lightbox-container="prod_images_grid_{{product.product_id}}" data-theme-thumbnail-container="theme-thumbnail-container-{{product.product_id}}" data-thumbnail-prod-id="{{product.product_id}}">
		{% for image in product.images %}
		<div class="theme-product-detail-thumbnail" onclick="showDetailImage(this)" data-thumbnail-active="{{ image.id }}" data-thumbnail="{{product.product_id}}" data-zs-image-id="{{ image.id }}" data-lightbox-thumbnail>
			{% if image.is_placeholder_image %}
			<picture>
				<img alt="{{ image.alternate_text }}" data-image-resolution="{{cdn_prefix_url}}{{ image.url }}{{cdn_suffix_url}} data-fallback-resolution="{{ image.url }}""
				data-fallback="{{ image.url }}"
				onerror="handleFallBackForImage(this)"
				data-zs-thumbnail-image src="{{ image.url }}">
			</picture>
			{% else %}
			<picture>
				<img alt="{{ image.alternate_text }}" data-image-resolution="{{cdn_prefix_url}}{{ image.url }}/800x800{{cdn_suffix_url}}" data-fallback-resolution="{{ image.url }}/800x800" data-zs-thumbnail-image src="{{cdn_prefix_url}}{{ image.url }}/400x400{{cdn_suffix_url}}"
				data-fallback="{{ image.url }}/800x800"
				onerror="handleFallBackForImage(this)">
			</picture>
			{% endif %}
		</div>
		{% endfor %}
	</div>

	{% endif %}
