            </svg>
          {% endif %}
          <span class='theme-sale-message'>{{i18n.get("product.message.sale")}}</span>
        </div>
      {% endif %}
      {% if product.is_out_of_stock == true && page.template_vars.product_list_style == '04' %}
        <div class="theme-ribbon-stock" data-zs-outofstock>{{i18n.get("product.message.out_of_stock")}}</div>
      {% endif %}
    </div>
    {% include '_store-product-list-image-loader' %}
    {% include '_store-product-list-image' %}
   
  </div>
  <div class="theme-product-details-area">
    <div class="theme-product-name-rating-price">
       {% if product.is_product_review_enabled && page.template_vars.product_list_style == '04' %}
        <div class="theme-brand-name-rating">
            <div class="theme-brand-name"  data-zs-brand="{{ product.brand }}">{{product.brand}}</div>
            <div class="theme-rating" data-zs-review-id = "{{ product.review_id }}" data-zs-review-type = "star-rating"></div>
        </div>
      {% endif %}
      <div class="theme-product-name {% if page.template_vars.product_list_style == '14' %} theme-product-name-rating {% endif %}" data-zs-product-name>
        <a title="{{ product.name }}" title="{{ product.name }}" href="{{ product.url }}">{{ product.name }}</a>
        {% if page.template_vars.product_list_style == '14' %}
          <div class="theme-rating" data-zs-review-id = "{{ product.review_id }}" data-zs-review-type = "average-rating"></div>
        {% endif %}
      </div>
      {% if page.template_vars.product_list_style == '07' %}
        {% if product.short_description %}
          <div class="theme-product-short-description" data-zs-product-short-description>
            {{ product.short_description }}
          </div>
        {% endif %}
        {% if product.is_product_review_enabled %}
          <div class="theme-rating" data-zs-review-id = "{{ product.review_id }}" data-zs-review-type = "star-rating"></div>
        {% endif %}
      {% endif %}
      <div class = "theme-product-price-variants">
        <div class="theme-product-price">
          {% if page.template_vars.product_list_style == '07' %}
            {% if product.is_out_of_stock == true %}
              <div class="theme-ribbon-stock" data-zs-outofstock>{{i18n.get("product.message.out_of_stock")}}</div>
            {% else %}
              {% include '_store-product-pricing-one' %}
            {% endif %}
          {% elif page.template_vars.product_list_style == '14' %}
            {% include '_store-product-pricing-one' %}
            {% if page.is_coupon_enabled && product.is_out_of_stock == false %}
              <div class="theme-prod-coupons-code-container" >
                <span class="theme-prod-coupons-code" data-list-coupon-code style="display:none"></span>
              </div> 
              <div class="theme-prod-coupons-container" style = "display:none" data-zs-coupon-product-id = "{{ product.product_id }}"></div>
            {% endif %}
          {% else %}
            {% include '_store-product-pricing-one' %}
          {% endif %}
        </div>
        {% if page.template_vars.product_list_style == '04' ||  page.template_vars.product_list_style == '14' %}
            {% include '_store-product-list-variants' %}
        {% endif %}
      </div>
    </div>
  </div>
</div>
